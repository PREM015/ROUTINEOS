  description String?
  color       String?
  icon        String?

  isDefault  Boolean @default(false) // true for the 5 seeded defaults, still user-editable
  isArchived Boolean @default(false) // soft-delete instead of hard delete
  sortOrder  Int     @default(0)

  routineTemplates  RoutineTemplate[]
  routineExceptions RoutineException[]
  habitAssignments  HabitDayType[]
  goalAssignments   GoalDayType[]

