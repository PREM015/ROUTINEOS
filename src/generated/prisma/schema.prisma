generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  passwordHash            String?
  role                    Role                     @default(USER)
  avatarUrl               String?
  bio                     String?
  displayName             String?
  timezone                String                   @default("UTC")
  preferredLanguage       String                   @default("en")
  preferences             String?
  socialSettings          String?
  emailVerified           DateTime?
  sessionVersion          Int                      @default(0)
  failedLoginAttempts     Int                      @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  lastActivityAt          DateTime?
  onboardingCompletedAt   DateTime?
  isActive                Boolean                  @default(true)
  isDeleted               Boolean                  @default(false)
  deletedAt               DateTime?
  deleteReason            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  aiInsights              AIInsight[]
  apiKeys                 APIKey[]
  achievements            Achievement[]
  activityLogs            ActivityLog[]
  attachments             Attachment[]
  auditLogs               AuditLog[]
  automationRules         AutomationRule[]
  breaks                  Break[]
  calendarSyncs           CalendarSync[]
  categories              Category[]
  challenges              Challenge[]
  challengeParticipations ChallengeParticipant[]
  dailyReflections        DailyReflection[]
  dailyScores             DailyScore[]
  dataExports             DataExport[]
  dayTypeDefinitions      DayTypeDefinition[]
  deviceSessions          DeviceSession[]
  emailVerificationTokens EmailVerificationToken[]
  energyLogs              EnergyLog[]
  feedback                Feedback[]
  focusDayTypeTargets     FocusDayTypeTarget[]
  focusPresets            FocusPreset[]
  focusSessions           FocusSession[]
  focusSessionEvents      FocusSessionEvent[]
  focusSettings           FocusSettings?
  goals                   Goal[]
  goalDayTypes            GoalDayType[]
  habits                  Habit[]
  habitLogs               HabitLog[]
  habitOverrides          HabitOverride[]
  healthMetrics           HealthMetric[]
  integrations            Integration[]
  journalEntries          JournalEntry[]
  journalRevisions        JournalRevision[]
  locations               Location[]
  minimumDayTemplates     MinimumDayTemplate[]
  monthlyResets           MonthlyReset[]
  moodLogs                MoodLog[]
  notificationLogs        NotificationLog[]
  nutritionEntries        NutritionEntry[]
  passwordResetTokens     PasswordResetToken[]
  productivityPatterns    ProductivityPattern[]
  projects                Project[]
  pushSubscriptions       PushSubscription[]
  quotes                  Quote[]
  routineBlocks           RoutineBlock[]
  routineExceptions       RoutineException[]
  routineLogs             RoutineLog[]
  routineTemplates        RoutineTemplate[]
  sleepLogs               SleepLog[]
  sleepSessions           SleepSession[]
  streak                  Streak?
  streakMilestones        StreakMilestone[]
  tags                    Tag[]
  tasks                   Task[]
  templates               Template[]
  timeEntries             TimeEntry[]
  tomorrowDayTypePlans    TomorrowDayTypePlan[]
  connections             UserConnection[]         @relation("UserFollows")
  followers               UserConnection[]         @relation("UserFollowing")
  settings                UserSettings?
  subscription            UserSubscription?
  weatherLogs             WeatherLog[]
  weeklyReviews           WeeklyReview[]

  @@index([email])
  @@index([isActive, isDeleted])
  @@index([lastActivityAt])
  @@index([role])
  @@index([createdAt])
}

model UserSubscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
}

model Quote {
  id         String   @id @default(cuid())
  userId     String
  text       String
  author     String?
  source     String?
  sourceUrl  String?
  isPublic   Boolean  @default(false)
  isFavorite Boolean  @default(false)
  tags       String?
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isFavorite])
  @@index([isPublic, createdAt])
  @@index([userId, createdAt])
}

model UserSettings {
  id                            String   @id @default(cuid())
  userId                        String   @unique
  timezone                      String   @default("UTC")
  language                      String   @default("en")
  dateFormat                    String   @default("YYYY-MM-DD")
  timeFormat                    String   @default("24h")
  weekStartsOn                  Int      @default(1)
  theme                         Theme    @default(LIGHT)
  customThemeColors             String?
  soundEnabled                  Boolean  @default(true)
  animationsEnabled             Boolean  @default(true)
  compactMode                   Boolean  @default(false)
  defaultView                   String   @default("dashboard")
  showCompletedTasks            Boolean  @default(false)
  targetBedtime                 String?
  targetWakeTime                String?
  minSleepDuration              Int?
  sleepReminder                 Boolean  @default(false)
  sleepReminderTime             String?
  sleepPreWarningEnabled        Boolean  @default(false)
  sleepPreWarningTime           String?
  autoStartSleepAfterMinutes    Int      @default(15)
  sleepAutoStartEnabled         Boolean  @default(true)
  sleepAutoStartAfterMinutes    Int      @default(15)
  wakeConfirmationEnabled       Boolean  @default(false)
  wakeConfirmationTime          String?
  weightNonNeg                  Float    @default(1.0)
  weightGrowth                  Float    @default(0.5)
  weightBonus                   Float    @default(0.25)
  notificationsEnabled          Boolean  @default(true)
  emailNotifications            Boolean  @default(true)
  pushNotifications             Boolean  @default(true)
  smsNotifications              Boolean  @default(false)
  quietHoursStart               String?
  quietHoursEnd                 String?
  routineStartNotifications     Boolean  @default(true)
  upcomingRoutineNotifications  Boolean  @default(true)
  sleepReminderNotifications    Boolean  @default(true)
  sleepPreWarningNotifications  Boolean  @default(true)
  wakeConfirmationNotifications Boolean  @default(true)
  habitReminderNotifications    Boolean  @default(true)
  goalReminderNotifications     Boolean  @default(true)
  advanceNotificationMinutes    Int      @default(0)
  dailyReminder                 Boolean  @default(true)
  dailyReminderTime             String?
  habitReminders                Boolean  @default(true)
  goalReminders                 Boolean  @default(true)
  weeklyReviewReminder          Boolean  @default(true)
  monthlyResetReminder          Boolean  @default(true)
  focusReminders                Boolean  @default(true)
  breakReminders                Boolean  @default(true)
  notificationRetryEnabled      Boolean  @default(true)
  notificationRetryIntervals    String?
  notificationMaxRetries        Int      @default(3)
  retroactiveEditDays           Int      @default(3)
  autoArchiveCompletedDays      Int      @default(90)
  dataRetentionDays             Int      @default(365)
  profilePublic                 Boolean  @default(false)
  shareStats                    Boolean  @default(false)
  aiInsightsEnabled             Boolean  @default(true)
  experimentalFeatures          Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

model Category {
  id             String         @id @default(cuid())
  userId         String
  name           String
  nameNormalized String
  description    String?
  color          String?
  icon           String?
  sortOrder      Int            @default(0)
  isArchived     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusPresets   FocusPreset[]
  focusSessions  FocusSession[]
  habits         Habit[]
  projects       Project[]
  routineBlocks  RoutineBlock[]

  @@unique([userId, nameNormalized])
  @@index([userId, isArchived])
  @@index([userId, createdAt])
  @@index([sortOrder])
}

model Tag {
  id             String            @id @default(cuid())
  userId         String
  name           String
  color          String?
  icon           String?
  createdAt      DateTime          @default(now())
  goals          GoalTag[]
  habits         HabitTag[]
  journalEntries JournalEntryTag[]
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          TaskTag[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model HabitTag {
  id      String @id @default(cuid())
  habitId String
  tagId   String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([habitId, tagId])
  @@index([tagId])
}

model GoalTag {
  id     String @id @default(cuid())
  goalId String
  tagId  String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([goalId, tagId])
  @@index([tagId])
}

model TaskTag {
  id     String @id @default(cuid())
  taskId String
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([tagId])
}

model JournalEntryTag {
  id      String       @id @default(cuid())
  entryId String
  tagId   String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag     Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([entryId, tagId])
  @@index([tagId])
}

model JournalRevision {
  id        String       @id @default(cuid())
  entryId   String
  userId    String
  title     String?
  content   String
  createdAt DateTime     @default(now())
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

model RoutineTemplate {
  id                String             @id @default(cuid())
  userId            String
  name              String
  description       String?
  dayType           DayType            @default(CUSTOM)
  dayTypeId         String?
  isDefault         Boolean            @default(false)
  color             String?
  icon              String?
  isActive          Boolean            @default(true)
  archivedAt        DateTime?
  estimatedDuration Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  blocks            RoutineBlock[]
  exceptions        RoutineException[]
  dayTypeDef        DayTypeDefinition? @relation(fields: [dayTypeId], references: [id])
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayType, isDefault])
  @@index([userId, isActive])
  @@index([userId, createdAt])
  @@index([dayTypeId])
}

model RoutineBlock {
  id              String          @id @default(cuid())
  userId          String
  templateId      String
  startTime       String
  endTime         String
  isOvernight     Boolean         @default(false)
  title           String
  description     String?
  notes           String?
  sortOrder       Int             @default(0)
  color           String?
  icon            String?
  categoryId      String?
  energyLevel     String?
  trackCompletion Boolean         @default(false)
  isRecurring     Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  focusSessions   FocusSession[]
  category        Category?       @relation(fields: [categoryId], references: [id])
  template        RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            RoutineLog[]

  @@index([templateId, sortOrder])
  @@index([userId, trackCompletion])
  @@index([userId, createdAt])
}

model RoutineException {
  id         String             @id @default(cuid())
  userId     String
  date       String
  dayType    DayType
  dayTypeId  String?
  templateId String?
  note       String?
  reason     String?
  createdAt  DateTime           @default(now())
  dayTypeDef DayTypeDefinition? @relation(fields: [dayTypeId], references: [id])
  template   RoutineTemplate?   @relation(fields: [templateId], references: [id])
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date, userId])
  @@index([dayTypeId])
}

model RoutineLog {
  id                 String            @id @default(cuid())
  routineBlockId     String
  userId             String
  date               String
  status             RoutineLogStatus
  actualStartTime    String?
  actualEndTime      String?
  durationMinutes    Int?
  focusRating        Int?
  productivityRating Int?
  energyLevel        Int?
  note               String?
  /// How the completion was recorded
  completionSource   CompletionSource?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  routineBlock       RoutineBlock      @relation(fields: [routineBlockId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, routineBlockId, date])
  @@index([userId, date])
  @@index([date, userId])
  @@index([status])
}

model Habit {
  id                  String                    @id @default(cuid())
  userId              String
  name                String
  description         String?
  tier                HabitTier                 @default(GROWTH)
  status              HabitStatus               @default(ACTIVE)
  categoryId          String?
  color               String?
  icon                String?
  frequencyType       HabitFrequencyType
  frequencyValue      String?
  targetCount         Int?
  startDate           DateTime                  @default(now())
  endDate             DateTime?
  archivedAt          DateTime?
  reminderTime        String?
  reminderEnabled     Boolean                   @default(false)
  points              Float?
  estimatedDuration   Int?
  difficulty          Int?
  isPublic            Boolean                   @default(false)
  appliesEveryDay     Boolean                   @default(true)
  streakCount         Int                       @default(0)
  longestStreak       Int                       @default(0)
  lastCompletedDate   String?
  completionRate      Float?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  focusSessions       FocusSession[]
  category            Category?                 @relation(fields: [categoryId], references: [id])
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayTypeAssignments  HabitDayType[]
  logs                HabitLog[]
  overrides           HabitOverride[]
  tags                HabitTag[]
  minimumDayTemplates MinimumDayTemplateHabit[]
  timeEntries         TimeEntry[]

  @@index([userId, status])
  @@index([userId, isPublic])
  @@index([categoryId])
  @@index([userId, createdAt])
  @@index([status, tier])
}

model HabitLog {
  id              String         @id @default(cuid())
  habitId         String
  userId          String
  date            String
  status          HabitLogStatus
  completedAt     DateTime?
  durationMinutes Int?
  quantity        Int?
  difficulty      Int?
  energyLevel     Int?
  moodBefore      Int?
  moodAfter       Int?
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  habit           Habit          @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, habitId, date])
  @@index([userId, date])
  @@index([date, userId])
  @@index([habitId, status])
}

model HabitOverride {
  id        String            @id @default(cuid())
  habitId   String
  userId    String
  type      HabitOverrideType
  startDate String
  endDate   String?
  reason    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  habit     Habit             @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([habitId, startDate])
  @@index([userId, type])
  @@index([userId, createdAt])
}

model MinimumDayTemplate {
  id          String                    @id @default(cuid())
  userId      String
  name        String
  description String?
  isDefault   Boolean                   @default(false)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits      MinimumDayTemplateHabit[]

  @@index([userId, isDefault])
  @@index([userId, createdAt])
}

model MinimumDayTemplateHabit {
  id         String             @id @default(cuid())
  templateId String
  habitId    String
  sortOrder  Int                @default(0)
  habit      Habit              @relation(fields: [habitId], references: [id], onDelete: Cascade)
  template   MinimumDayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, habitId])
  @@index([templateId, sortOrder])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  priority    GoalPriority  @default(MEDIUM)
  categoryId  String?
  color       String?
  icon        String?
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  archivedAt  DateTime?
  progress    Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  goals       Goal[]
  category    Category?     @relation(fields: [categoryId], references: [id])
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  timeEntries TimeEntry[]

  @@index([userId, status])
  @@index([status, priority])
  @@index([userId, createdAt])
}

model Goal {
  id                 String         @id @default(cuid())
  userId             String
  projectId          String?
  type               GoalType
  priority           GoalPriority   @default(MEDIUM)
  status             GoalStatus     @default(ACTIVE)
  title              String
  description        String?
  targetValue        Float
  currentValue       Float          @default(0)
  unit               String?
  startDate          DateTime
  endDate            DateTime
  completedAt        DateTime?
  archivedAt         DateTime?
  parentGoalId       String?
  carriedOverFrom    String?
  isPublic           Boolean        @default(false)
  appliesEveryDay    Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  focusSessions      FocusSession[]
  parentGoal         Goal?          @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  subGoals           Goal[]         @relation("GoalHierarchy")
  project            Project?       @relation(fields: [projectId], references: [id])
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayTypeAssignments GoalDayType[]
  progressLogs       GoalProgress[]
  tags               GoalTag[]
  milestones         Milestone[]
  tasks              Task[]
  timeEntries        TimeEntry[]

  @@index([userId, status, endDate])
  @@index([projectId])
  @@index([status, priority])
  @@index([userId, createdAt])
}

model Milestone {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  description String?
  targetValue Float?
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, sortOrder])
  @@index([dueDate])
  @@index([goalId, createdAt])
}

model GoalProgress {
  id        String   @id @default(cuid())
  goalId    String
  value     Float
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, date])
  @@index([goalId, date])
}

model Task {
  id               String           @id @default(cuid())
  userId           String
  title            String
  description      String?
  status           TaskStatus       @default(TODO)
  priority         TaskPriority     @default(MEDIUM)
  projectId        String?
  goalId           String?
  parentTaskId     String?
  dueDate          DateTime?
  scheduledFor     DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  isUrgent         Boolean          @default(false)
  isImportant      Boolean          @default(false)
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  focusSessions    FocusSession[]
  goal             Goal?            @relation(fields: [goalId], references: [id])
  parentTask       Task?            @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks         Task[]           @relation("TaskSubtasks")
  project          Project?         @relation(fields: [projectId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks           TaskDependency[] @relation("TaskBlocks")
  dependsOn        TaskDependency[] @relation("TaskDependencies")
  tags             TaskTag[]

  @@index([userId, status])
  @@index([status, priority])
  @@index([dueDate])
  @@index([scheduledFor])
  @@index([userId, createdAt])
}

model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String
  dependsOn   Task   @relation("TaskBlocks", fields: [dependsOnId], references: [id])
  task        Task   @relation("TaskDependencies", fields: [taskId], references: [id])

  @@unique([taskId, dependsOnId])
}

model SleepLog {
  id                     String   @id @default(cuid())
  userId                 String
  date                   String
  targetBedtime          String?
  targetWakeTime         String?
  actualBedtime          String?
  actualWakeTime         String?
  actualDurationMinutes  Int?
  availableWindowMinutes Int?
  deficitMinutes         Int?
  quality                Int?
  wakeUpCount            Int?
  feltRested             Boolean?
  moodOnWaking           Int?
  energyOnWaking         Int?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date, userId])
}

model SleepSession {
  id              String             @id @default(cuid())
  userId          String
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  status          SleepSessionStatus @default(ACTIVE)
  source          SleepStartSource   @default(MANUAL)
  promptKey       String?
  durationMinutes Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promptKey])
  @@index([userId, status])
  @@index([userId, startedAt])
  @@index([userId, updatedAt])
}

model MoodLog {
  id         String   @id @default(cuid())
  userId     String
  timestamp  DateTime @default(now())
  mood       Int
  energy     Int?
  stress     Int?
  anxiety    Int?
  focus      Int?
  triggers   String?
  activities String?
  location   String?
  weather    String?
  notes      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([mood])
  @@index([userId, createdAt])
}

model EnergyLog {
  id          String   @id @default(cuid())
  userId      String
  timestamp   DateTime @default(now())
  energyLevel Int
  activity    String?
  location    String?
  notes       String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([userId, createdAt])
}

model WeatherLog {
  id          String           @id @default(cuid())
  userId      String
  date        String
  condition   WeatherCondition
  temperature Float?
  humidity    Int?
  notes       String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date, userId])
}

model HealthMetric {
  id         String   @id @default(cuid())
  userId     String
  date       String
  metricType String
