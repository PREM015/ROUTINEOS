  updatedAt DateTime @updatedAt

  focusTargets FocusDayTypeTarget[]

  @@unique([userId, slug])
  @@index([userId, isArchived])
  @@index([userId, sortOrder])
}

// NEW JOIN TABLE — Habit <-> DayTypeDefinition, fully separate from routine
model HabitDayType {
