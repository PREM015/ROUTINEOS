// Audit Enums
enum AuditAction {
  HABIT_CREATED
  HABIT_UPDATED
  HABIT_ARCHIVED
  HABIT_RESTORED
  HABIT_DELETED
  HABIT_PAUSED
  HABIT_RESUMED
  GOAL_CREATED
  GOAL_UPDATED
  GOAL_DELETED
  GOAL_COMPLETED
  // Goal-scoped variants for the two domains that were writing the `GOAL_*`
  // values above for non-goal entities. `ProjectService` stamped
  // `GOAL_CREATED` with `entityType: 'PROJECT'` and `TaskService` did the same
  // with `'TASK'`, so any query on `action: 'GOAL_CREATED'` that did not also
  // filter `entityType` returned goals + projects + tasks. These give each domain
  // its own values, so the action alone is unambiguous.
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  PROJECT_ARCHIVED
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_ARCHIVED
  ROUTINE_CREATED
  ROUTINE_CHANGED
  ROUTINE_DELETED
  SCORING_SETTINGS_CHANGED
  MINIMUM_DAY_ACTIVATED
  REST_DAY_ACTIVATED
  DATA_EXPORTED
  DATA_IMPORTED
  DATA_RESET
  ACCOUNT_DELETED
  LOGIN_FAILED
  LOGIN_SUCCESS
  ACCOUNT_LOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  /**
   * Sign-out of the current device only.
   */
  LOGOUT
  /**
   * Sign-out of every device (`POST /api/auth/logout-all`).
   */
  LOGOUT_ALL_SESSIONS
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  EMAIL_VERIFIED
  SETTINGS_UPDATED
}

// ==========================================================================
// CORE USER & AUTHENTICATION MODELS
// ==========================================================================

model User {
  id           String  @id @default(cuid())
  name         String?
  email        String  @unique
  passwordHash String?
  role         Role    @default(USER)

  // Profile Information
  avatarUrl   String?
  bio         String? @db.Text
  displayName String?
  timezone    String  @default("UTC")

  // User Preferences
  preferredLanguage String  @default("en")
  preferences       String? @db.Text // JSON with advanced preferences
  socialSettings    String? @db.Text // JSON with social/privacy settings

  // Authentication & Security
  emailVerified       DateTime?
  sessionVersion      Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastActivityAt      DateTime?

  // Account Status
  onboardingCompletedAt DateTime?
  isActive              Boolean   @default(true)
  isDeleted             Boolean   @default(false)
  deletedAt             DateTime?
  deleteReason          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Core System Relations
  settings     UserSettings?
  subscription UserSubscription?

  // Content & Organization
  quotes     Quote[]
  categories Category[]
  tags       Tag[]

  // Routine & Schedule
  routineTemplates  RoutineTemplate[]
  routineBlocks     RoutineBlock[]
  routineExceptions RoutineException[]
  routineLogs       RoutineLog[]

  // Habits & Tracking
  habits              Habit[]
  habitLogs           HabitLog[]
  habitOverrides      HabitOverride[]
  minimumDayTemplates MinimumDayTemplate[]

  // Goals & Projects
  goals    Goal[]
  projects Project[]
  tasks    Task[]

  // Wellness & Health
  sleepLogs        SleepLog[]
  sleepSessions    SleepSession[]
  moodLogs         MoodLog[]
  energyLogs       EnergyLog[]
  weatherLogs      WeatherLog[]
  healthMetrics    HealthMetric[]
  nutritionEntries NutritionEntry[]

  // Journaling & Reflection
  journalEntries   JournalEntry[]
  journalRevisions JournalRevision[]
  dailyReflections DailyReflection[]

  // Productivity & Focus
  focusSessions        FocusSession[]
  focusSessionEvents   FocusSessionEvent[]
  focusSettings        FocusSettings?
  focusPresets         FocusPreset[]
  focusDayTypeTargets  FocusDayTypeTarget[]
  breaks               Break[]
  timeEntries          TimeEntry[]
  productivityPatterns ProductivityPattern[]

  // Scoring & Analytics
  dailyScores DailyScore[]
  aiInsights  AIInsight[]

  // Achievements & Streaks
  streak           Streak?
  streakMilestones StreakMilestone[]
  achievements     Achievement[]

  // Reviews & Planning
  weeklyReviews WeeklyReview[]
  monthlyResets MonthlyReset[]

  // Social & Community
  challenges              Challenge[]
  challengeParticipations ChallengeParticipant[]
  connections             UserConnection[]       @relation("UserFollows")
  followers               UserConnection[]       @relation("UserFollowing")

  // Automation & Rules
  automationRules AutomationRule[]
  locations       Location[]
  calendarSyncs   CalendarSync[]

  // System & Technical
  auditLogs               AuditLog[]
  activityLogs            ActivityLog[]
  notificationLogs        NotificationLog[]
  pushSubscriptions       PushSubscription[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  templates               Template[]
  attachments             Attachment[]
  integrations            Integration[]
  deviceSessions          DeviceSession[]
  dataExports             DataExport[]
  feedback                Feedback[]
  apiKeys                 APIKey[]
  dayTypeDefinitions      DayTypeDefinition[]
  goalDayTypes            GoalDayType[]
  tomorrowDayTypePlans    TomorrowDayTypePlan[]

  @@index([email])
  @@index([isActive, isDeleted])
  @@index([lastActivityAt])
  @@index([role])
  @@index([createdAt])
}

model UserSubscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
}

model Quote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text      String  @db.Text
  author    String?
  source    String?
  sourceUrl String?

  isPublic   Boolean @default(false)
  isFavorite Boolean @default(false)

  tags       String? // JSON array
  usageCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isFavorite])
  @@index([isPublic, createdAt])
  @@index([userId, createdAt])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Localization
  //
  // AUTHORITATIVE timezone field. Every date-bucketing read (habit logs, daily
  // scores, streaks, analytics ranges, sleep sessions) resolves
  // `UserSettings.timezone`, not `User.timezone`.
  //
  // It previously defaulted to "Asia/Kolkata" while `User.timezone` defaulted to
  // "UTC", so a user who had never chosen a timezone had two different answers
  // depending on which column a given code path happened to read. `User.timezone`
  // now defaults to the same value, and `UserService.updateSettings` writes both
  // in one call. Defaulting to "UTC" also matches `DEFAULT_TZ` in `lib/dates.ts`.
  timezone     String @default("UTC")
  language     String @default("en")
  dateFormat   String @default("YYYY-MM-DD")
  timeFormat   String @default("24h") // 12h or 24h
  weekStartsOn Int    @default(1) // 0-6, 0=Sunday, 1=Monday

  // UI/UX preferences
  theme              Theme   @default(LIGHT)
  customThemeColors  String? // JSON
  soundEnabled       Boolean @default(true)
  animationsEnabled  Boolean @default(true)
  compactMode        Boolean @default(false)
  defaultView        String  @default("dashboard")
  showCompletedTasks Boolean @default(false)

  // Sleep
  targetBedtime              String?
  targetWakeTime             String?
  minSleepDuration           Int?
  sleepReminder              Boolean @default(false)
  sleepReminderTime          String?
  sleepPreWarningEnabled     Boolean @default(false)
  sleepPreWarningTime        String?
  autoStartSleepAfterMinutes Int     @default(15)
  sleepAutoStartEnabled      Boolean @default(true)
  sleepAutoStartAfterMinutes Int     @default(15)
  wakeConfirmationEnabled    Boolean @default(false)
  wakeConfirmationTime       String?

  // Scoring weights
  weightNonNeg Float @default(1.0)
  weightGrowth Float @default(0.5)
  weightBonus  Float @default(0.25)

  // Notifications
  notificationsEnabled Boolean @default(true)
  emailNotifications   Boolean @default(true)
  pushNotifications    Boolean @default(true)
  smsNotifications     Boolean @default(false)
  quietHoursStart      String?
  quietHoursEnd        String?

  // Per-category notification toggles. The notifications settings page exposes
  // one switch per category; without these columns the payload was silently
  // stripped by Zod and the toggles appeared to save but reset on reload.
  routineStartNotifications     Boolean @default(true)
  upcomingRoutineNotifications  Boolean @default(true)
  sleepReminderNotifications    Boolean @default(true)
  sleepPreWarningNotifications  Boolean @default(true)
  wakeConfirmationNotifications Boolean @default(true)
  habitReminderNotifications    Boolean @default(true)
  goalReminderNotifications     Boolean @default(true)

  // How many minutes before a routine block starts to deliver its reminder.
  // 0 means "notify at start time".
  advanceNotificationMinutes Int @default(0)

  // Reminders
  dailyReminder        Boolean @default(true)
  dailyReminderTime    String?
  habitReminders       Boolean @default(true)
  goalReminders        Boolean @default(true)
  weeklyReviewReminder Boolean @default(true)
  monthlyResetReminder Boolean @default(true)
  focusReminders       Boolean @default(true)
  breakReminders       Boolean @default(true)

  // Data
  retroactiveEditDays      Int @default(3)
  autoArchiveCompletedDays Int @default(90)
  dataRetentionDays        Int @default(365)

  // Privacy
  profilePublic Boolean @default(false)
  shareStats    Boolean @default(false)

  // Advanced
  aiInsightsEnabled    Boolean @default(true)
  experimentalFeatures Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

model EmailVerificationToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

// ==========================================================================
// CATEGORIES & TAGS
// ==========================================================================

model Category {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  nameNormalized String
  description    String?
  color          String?
  icon           String?

  sortOrder  Int     @default(0)
  isArchived Boolean @default(false)

  habits        Habit[]
  routineBlocks RoutineBlock[]
  focusSessions FocusSession[]
  projects      Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  focusPresets FocusPreset[]

  @@unique([userId, nameNormalized])
  @@index([userId, isArchived])
  @@index([userId, createdAt])
  @@index([sortOrder])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String?
  icon  String?

  habits         HabitTag[]
  goals          GoalTag[]
  journalEntries JournalEntryTag[]
  tasks          TaskTag[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model HabitTag {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([habitId, tagId])
  @@index([tagId])
}

model GoalTag {
  id     String @id @default(cuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([goalId, tagId])
  @@index([tagId])
}

model TaskTag {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([tagId])
}

model JournalEntryTag {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([entryId, tagId])
  @@index([tagId])
}

model JournalRevision {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String?
  content String  @db.Text

  createdAt DateTime @default(now())

  @@index([entryId, createdAt])
}

// ==========================================================================
// ROUTINE MANAGEMENT
// ==========================================================================

model RoutineTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  dayType     DayType            @default(CUSTOM) // KEEP for now, see migration steps
  dayTypeId   String? // NEW — nullable during migration
  dayTypeDef  DayTypeDefinition? @relation(fields: [dayTypeId], references: [id], onDelete: SetNull)
  isDefault   Boolean            @default(false)

  color      String?
  icon       String?
  isActive   Boolean   @default(true)
  archivedAt DateTime?

  estimatedDuration Int? // total minutes

  blocks     RoutineBlock[]
  exceptions RoutineException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dayType, isDefault])
  @@index([userId, isActive])
  @@index([userId, createdAt])
  @@index([dayTypeId])
}

model RoutineBlock {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String
  template   RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  startTime   String // HH:mm
  endTime     String // HH:mm
  isOvernight Boolean @default(false)

  title       String
  description String? @db.Text
  notes       String? @db.Text

  sortOrder Int @default(0)

  color String?
  icon  String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Energy tracking
  energyLevel String? // HIGH, MEDIUM, LOW

  // Completion tracking
  trackCompletion Boolean @default(false)
  isRecurring     Boolean @default(true)

  logs RoutineLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  focusSessions FocusSession[]

  @@index([templateId, sortOrder])
  @@index([userId, trackCompletion])
  @@index([userId, createdAt])
}

model RoutineException {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       String // YYYY-MM-DD
  dayType    DayType // KEEP for now, see migration steps
  dayTypeId  String? // NEW — nullable during migration
  dayTypeDef DayTypeDefinition? @relation(fields: [dayTypeId], references: [id], onDelete: SetNull)

  templateId String?
  template   RoutineTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  note   String? @db.Text
  reason String?

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date, userId])
  @@index([dayTypeId])
}

model RoutineLog {
  id             String       @id @default(cuid())
  routineBlockId String
  routineBlock   RoutineBlock @relation(fields: [routineBlockId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   String // YYYY-MM-DD
  status RoutineLogStatus

  // Actual times
  actualStartTime String? // HH:mm
  actualEndTime   String? // HH:mm
  durationMinutes Int?

  // Ratings
  focusRating        Int? // 1-5
  productivityRating Int? // 1-5
  energyLevel        Int? // 1-5

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, routineBlockId, date])
  @@index([userId, date])
  @@index([date, userId])
  @@index([status])
}

// ==========================================================================
// HABIT MANAGEMENT
// ==========================================================================

model Habit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  tier   HabitTier   @default(GROWTH)
  status HabitStatus @default(ACTIVE)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Visual
  color String?
  icon  String?

  // Frequency
  frequencyType  HabitFrequencyType
  frequencyValue String? // "1,3,5" for weekdays, "4" for Nx/week, "20" for Nx/month
  targetCount    Int? // for countable habits (e.g., "drink 8 glasses of water")

  // Dates
  startDate  DateTime  @default(now())
  endDate    DateTime?
  archivedAt DateTime?

  // Reminders
  reminderTime    String?
  reminderEnabled Boolean @default(false)

  // Scoring
  points Float? // overrides tier default

  // Tracking
  estimatedDuration Int? // minutes
  difficulty        Int? // 1-5

  // Visibility
  isPublic Boolean @default(false)

  // Day-type-specific habits (NEW)
  appliesEveryDay    Boolean        @default(true) // NEW field
  dayTypeAssignments HabitDayType[]

  // Derived/cached fields for performance
  streakCount       Int     @default(0)
