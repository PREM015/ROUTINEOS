generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")  // Fixed: Added database URL
}

// ==========================================================================
// ENUMS
// ==========================================================================

// Core User & Auth Enums
enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Theme {
  LIGHT
  DARK
  AUTO
  CUSTOM
}

enum DeviceType {
  WEB
  MOBILE_IOS
  MOBILE_ANDROID
  TABLET
  DESKTOP
}

// Subscription Enums
enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

// Routine & Schedule Enums
enum DayType {
  WORKDAY
  WEEKEND
  HOLIDAY
  EXAM_DAY
  LOW_ENERGY
  CUSTOM
}

enum RoutineLogStatus {
  COMPLETED
  MISSED
  PARTIAL
  IN_PROGRESS
}

