// ==========================================================================
// CORE USER & AUTHENTICATION MODELS
// ==========================================================================

model User {
  id           String  @id @default(cuid())
  name         String?
  email        String  @unique
  passwordHash String?
  role         Role    @default(USER)

  // Profile Information
  avatarUrl   String?
  bio         String? @db.Text
  displayName String?
  timezone    String  @default("UTC")

  // User Preferences
  preferredLanguage String  @default("en")
  preferences       String? @db.Text // JSON with advanced preferences
  socialSettings    String? @db.Text // JSON with social/privacy settings

  // Authentication & Security
  emailVerified       DateTime?
  sessionVersion      Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastActivityAt      DateTime?

  // Account Status
  onboardingCompletedAt DateTime?
  isActive              Boolean   @default(true)
  isDeleted             Boolean   @default(false)
  deletedAt             DateTime?
  deleteReason          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Core System Relations
  settings     UserSettings?
  subscription UserSubscription?

  // Content & Organization
  quotes     Quote[]
  categories Category[]
  tags       Tag[]

  // Routine & Schedule
  routineTemplates  RoutineTemplate[]
  routineBlocks     RoutineBlock[]
  routineExceptions RoutineException[]
  routineLogs       RoutineLog[]

  // Habits & Tracking
  habits              Habit[]
  habitLogs           HabitLog[]
  habitOverrides      HabitOverride[]
  minimumDayTemplates MinimumDayTemplate[]

  // Goals & Projects
  goals    Goal[]
  projects Project[]
  tasks    Task[]

  // Wellness & Health
  sleepLogs        SleepLog[]
  moodLogs         MoodLog[]
  energyLogs       EnergyLog[]
  weatherLogs      WeatherLog[]
  healthMetrics    HealthMetric[]
  nutritionEntries NutritionEntry[]

  // Journaling & Reflection
  journalEntries   JournalEntry[]
  dailyReflections DailyReflection[]

  // Productivity & Focus
  focusSessions        FocusSession[]
  breaks               Break[]
  timeEntries          TimeEntry[]
  productivityPatterns ProductivityPattern[]

  // Scoring & Analytics
  dailyScores DailyScore[]
  aiInsights  AIInsight[]

  // Achievements & Streaks
  streak           Streak?
  streakMilestones StreakMilestone[]
  achievements     Achievement[]

  // Reviews & Planning
  weeklyReviews WeeklyReview[]
  monthlyResets MonthlyReset[]

  // Social & Community
  challenges              Challenge[]
  challengeParticipations ChallengeParticipant[]
  connections             UserConnection[]       @relation("UserFollows")
  followers               UserConnection[]       @relation("UserFollowing")

  // Automation & Rules
  automationRules AutomationRule[]
  locations       Location[]
  calendarSyncs   CalendarSync[]

  // System & Technical
  auditLogs               AuditLog[]
  activityLogs            ActivityLog[]
  notificationLogs        NotificationLog[]
  pushSubscriptions       PushSubscription[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  templates               Template[]
  attachments             Attachment[]
  integrations            Integration[]
  deviceSessions          DeviceSession[]
  dataExports             DataExport[]
  feedback                Feedback[]
  apiKeys                 APIKey[]

  @@index([email])
  @@index([isActive, isDeleted])
  @@index([lastActivityAt])
  @@index([role])
  @@index([createdAt])
}

model UserSubscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
}

model Quote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text      String  @db.Text
  author    String?
  source    String?
  sourceUrl String?

  isPublic   Boolean @default(false)
  isFavorite Boolean @default(false)

  tags       String? // JSON array
  usageCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isFavorite])
  @@index([isPublic, createdAt])
  @@index([userId, createdAt])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Localization
  timezone     String @default("Asia/Kolkata")
  language     String @default("en")
  dateFormat   String @default("YYYY-MM-DD")
  timeFormat   String @default("24h") // 12h or 24h
  weekStartsOn Int    @default(1) // 0-6, 0=Sunday, 1=Monday

  // UI/UX preferences
  theme              Theme   @default(LIGHT)
  customThemeColors  String? // JSON
  soundEnabled       Boolean @default(true)
  animationsEnabled  Boolean @default(true)
  compactMode        Boolean @default(false)
  defaultView        String  @default("dashboard")
  showCompletedTasks Boolean @default(false)

  // Sleep
  targetBedtime     String?
  targetWakeTime    String?
  minSleepDuration  Int?
  sleepReminder     Boolean @default(false)
  sleepReminderTime String?

  // Scoring weights
  weightNonNeg Float @default(1.0)
  weightGrowth Float @default(0.5)
  weightBonus  Float @default(0.25)

  // Notifications
  notificationsEnabled Boolean @default(true)
  emailNotifications   Boolean @default(true)
  pushNotifications    Boolean @default(true)
  smsNotifications     Boolean @default(false)
  quietHoursStart      String?
  quietHoursEnd        String?

  // Reminders
  dailyReminder        Boolean @default(true)
  dailyReminderTime    String?
  habitReminders       Boolean @default(true)
  goalReminders        Boolean @default(true)
  weeklyReviewReminder Boolean @default(true)
  monthlyResetReminder Boolean @default(true)
  focusReminders       Boolean @default(true)
  breakReminders       Boolean @default(true)

  // Data
  retroactiveEditDays      Int @default(3)
  autoArchiveCompletedDays Int @default(90)
  dataRetentionDays        Int @default(365)

  // Privacy
  profilePublic Boolean @default(false)
  shareStats    Boolean @default(false)

  // Advanced
  aiInsightsEnabled    Boolean @default(true)
  experimentalFeatures Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

model EmailVerificationToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

// ==========================================================================
// CATEGORIES & TAGS
// ==========================================================================

model Category {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  nameNormalized String
  description    String?
  color          String?
  icon           String?

  sortOrder  Int     @default(0)
  isArchived Boolean @default(false)

  habits        Habit[]
  routineBlocks RoutineBlock[]
  focusSessions FocusSession[]
  projects      Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, nameNormalized])
  @@index([userId, isArchived])
  @@index([userId, createdAt])
  @@index([sortOrder])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String?
  icon  String?

  habits         HabitTag[]
  goals          GoalTag[]
  journalEntries JournalEntryTag[]
  tasks          TaskTag[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model HabitTag {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([habitId, tagId])
  @@index([tagId])
}

model GoalTag {
  id     String @id @default(cuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([goalId, tagId])
  @@index([tagId])
}

model TaskTag {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([tagId])
}

model JournalEntryTag {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([entryId, tagId])
  @@index([tagId])
}

// ==========================================================================
// ROUTINE MANAGEMENT
// ==========================================================================

model RoutineTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  dayType     DayType @default(CUSTOM)
  isDefault   Boolean @default(false)

  color      String?
  icon       String?
  isActive   Boolean   @default(true)
  archivedAt DateTime?

  estimatedDuration Int? // total minutes

  blocks     RoutineBlock[]
  exceptions RoutineException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dayType, isDefault])
  @@index([userId, isActive])
  @@index([userId, createdAt])
}

model RoutineBlock {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String
  template   RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  startTime   String // HH:mm
  endTime     String // HH:mm
  isOvernight Boolean @default(false)

  title       String
  description String? @db.Text
  notes       String? @db.Text

  sortOrder Int @default(0)

  color String?
  icon  String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Energy tracking
  energyLevel String? // HIGH, MEDIUM, LOW

  // Completion tracking
  trackCompletion Boolean @default(false)
  isRecurring     Boolean @default(true)

  logs RoutineLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId, sortOrder])
  @@index([userId, trackCompletion])
  @@index([userId, createdAt])
}

model RoutineException {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date    String // YYYY-MM-DD
  dayType DayType

  templateId String?
  template   RoutineTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  note   String? @db.Text
  reason String?

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date, userId])
}

model RoutineLog {
  id             String       @id @default(cuid())
  routineBlockId String
  routineBlock   RoutineBlock @relation(fields: [routineBlockId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   String // YYYY-MM-DD
  status RoutineLogStatus

  // Actual times
  actualStartTime String? // HH:mm
  actualEndTime   String? // HH:mm
  durationMinutes Int?

  // Ratings
  focusRating        Int? // 1-5
  productivityRating Int? // 1-5
  energyLevel        Int? // 1-5

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, routineBlockId, date])
  @@index([userId, date])
  @@index([date, userId])
  @@index([status])
}

// ==========================================================================
// HABIT MANAGEMENT
// ==========================================================================

model Habit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  tier   HabitTier   @default(GROWTH)
  status HabitStatus @default(ACTIVE)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Visual
  color String?
  icon  String?

  // Frequency
  frequencyType  HabitFrequencyType
  frequencyValue String? // "1,3,5" for weekdays, "4" for Nx/week, "20" for Nx/month
  targetCount    Int? // for countable habits (e.g., "drink 8 glasses of water")

  // Dates
  startDate  DateTime  @default(now())
  endDate    DateTime?
  archivedAt DateTime?

  // Reminders
  reminderTime    String?
  reminderEnabled Boolean @default(false)

  // Scoring
  points Float? // overrides tier default

  // Tracking
  estimatedDuration Int? // minutes
  difficulty        Int? // 1-5

  // Visibility
  isPublic Boolean @default(false)

  // Derived/cached fields for performance
  streakCount       Int     @default(0)
  longestStreak     Int     @default(0)
  lastCompletedDate String?
  completionRate    Float? // cached percentage

  logs                HabitLog[]
  overrides           HabitOverride[]
  minimumDayTemplates MinimumDayTemplateHabit[]
  tags                HabitTag[]
  timeEntries         TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, isPublic])
  @@index([categoryId])
  @@index([userId, createdAt])
  @@index([status, tier])
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   String // YYYY-MM-DD
  status HabitLogStatus

  // Completion details
  completedAt     DateTime?
  durationMinutes Int?
  quantity        Int? // for countable habits

  // Subjective tracking
  difficulty  Int? // 1-5, how hard was it?
  energyLevel Int? // 1-5
  moodBefore  Int? // 1-5
  moodAfter   Int? // 1-5

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, habitId, date])
  @@index([userId, date])
  @@index([date, userId])
  @@index([habitId, status])
}

model HabitOverride {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      HabitOverrideType
  startDate String
  endDate   String?
  reason    String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([habitId, startDate])
  @@index([userId, type])
  @@index([userId, createdAt])
}

// ==========================================================================
// MINIMUM DAY TEMPLATES
// ==========================================================================

model MinimumDayTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isDefault   Boolean @default(false)

  habits MinimumDayTemplateHabit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
  @@index([userId, createdAt])
}

model MinimumDayTemplateHabit {
  id         String             @id @default(cuid())
  templateId String
  template   MinimumDayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  habitId    String
  habit      Habit              @relation(fields: [habitId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@unique([templateId, habitId])
  @@index([templateId, sortOrder])
}

// ==========================================================================
// PROJECTS & GOALS
// ==========================================================================

model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  status   ProjectStatus @default(ACTIVE)
  priority GoalPriority  @default(MEDIUM)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  color String?
  icon  String?

  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  archivedAt  DateTime?

  progress Float @default(0) // 0-100

  goals       Goal[]
  tasks       Task[]
  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, priority])
  @@index([userId, createdAt])
}

model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type     GoalType
  priority GoalPriority @default(MEDIUM)
  status   GoalStatus   @default(ACTIVE)

  title       String
  description String? @db.Text

  targetValue  Float
  currentValue Float   @default(0)
  unit         String?

  startDate DateTime
  endDate   DateTime

  completedAt DateTime?
  archivedAt  DateTime?

  // For sub-goals
  parentGoalId String?
  parentGoal   Goal?   @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  subGoals     Goal[]  @relation("GoalHierarchy")

  carriedOverFrom String?

  // Visibility
  isPublic Boolean @default(false)

  milestones   Milestone[]
  progressLogs GoalProgress[]
  tags         GoalTag[]
  timeEntries  TimeEntry[]
  tasks        Task[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId, status, endDate])
  @@index([projectId])
  @@index([status, priority])
  @@index([userId, createdAt])
}

