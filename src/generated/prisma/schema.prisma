// ==========================================================================
// ==========================================================================
// DAY TYPE DEFINITIONS (Stage 1: Additive - replaces DayType enum role)
// ==========================================================================

model DayTypeDefinition {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String // "College Day", "Weekend", "Holiday", etc.
