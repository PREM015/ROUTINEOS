  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, priority])
  @@index([dueDate])
  @@index([scheduledFor])
  @@index([userId, createdAt])
}

model TaskDependency {
  id          String @id @default(cuid())
