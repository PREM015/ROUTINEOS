  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

// Task Enums
enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
  PERSONAL
  ACADEMIC
  NON_PROFIT
  PROFESSIONAL
}

// Weather & Environment Enums
enum WeatherCondition {
  SUNNY
  PARTLY_CLOUDY
  CLOUDY
  RAINY
  STORMY
  SNOWY
  FOGGY
  WINDY
