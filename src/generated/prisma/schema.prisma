// ==========================================================================

model Streak {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStreak    Int @default(0)
  longestStreak    Int @default(0)
  coreStreak       Int @default(0)
  growthStreak     Int @default(0)
  minimumDayStreak Int @default(0)

  streakStartDate   String?
  lastCompletedDate String?

  // Metadata
  totalCompletedDays Int @default(0)
  totalMinimumDays   Int @default(0)
  totalRestDays      Int @default(0)

  updatedAt DateTime @updatedAt
}

model StreakMilestone {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  milestoneDays Int
  streakType    String // "current" | "core" | "growth"
  reachedDate   String

  celebrated Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, milestoneDays, streakType, reachedDate])
  @@index([userId, celebrated])
  @@index([userId, createdAt])
}

model Achievement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        AchievementType
  title       String
  description String?         @db.Text

  icon  String?
  color String?

  level Int @default(1) // for tiered achievements

  unlockedAt DateTime @default(now())
  celebrated Boolean  @default(false)
  isPublic   Boolean  @default(false)

  metadata String? // JSON with achievement details

  /// Stable catalogue key (an id in `ACHIEVEMENT_DEFINITIONS`).
  ///
  /// This is the canonical join key between an unlocked row and the definition
  /// catalogue; `metadata.definitionId` carries the same value for rows written
  /// before the column existed and is still read as a fallback. Matching on
  /// `title` — which is what the achievements page used to do — breaks the
  /// moment a definition is renamed, silently dropping the badge out of the
  /// grid and out of the XP total.
  ///
  /// Nullable on purpose: `CUSTOM` achievements are not in the catalogue, and
  /// Postgres treats NULLs as distinct inside a unique index, so those rows stay
  /// unrestricted while a catalogue achievement can be earned exactly once.
  definitionId String?

  createdAt DateTime @default(now())

  @@unique([userId, definitionId], map: "userId_definitionId")
  @@index([userId, unlockedAt])
  @@index([type, level])
  @@index([userId, createdAt])
}

