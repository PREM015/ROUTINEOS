// ==========================================================================
// FOCUS & PRODUCTIVITY
// ==========================================================================

model FocusSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text

  /// What kind of timer row this is.
  ///
  /// This is the only thing that distinguishes real work from a break. Before
  /// the column existed, the *title* was the only record of it ('Focus session'
  /// / 'Short break' / 'Long break' / 'Stopwatch session'), so every aggregate
  /// that wanted "focus minutes" had to guess — and the timer wrote a completed
  /// row for each break, so a 5-minute break was added to every focus total in
  /// the product. `src/lib/focus/type-backfill.ts` owns the title mapping used
  /// to backfill existing rows.
  ///
  /// Defaults to `FOCUS`, which is exactly what the old (title-blind)
  /// aggregations counted, so the default is behaviour-preserving.
  type FocusSessionType @default(FOCUS)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Duration
  plannedDuration Int // minutes
  actualDuration  Int? // minutes

  // Times
  startedAt   DateTime
  completedAt DateTime?
  /// Set when the user stopped, skipped or switched mode before the session
  /// finished. Without it an aborted session has `completedAt: null`, which is
  /// exactly the shape `findActiveByUserId` uses to find a *running* session —
  /// so stopped timers were reported as "IN PROGRESS" forever, and setting
  /// `completedAt` instead would have counted them as completed work.
  abortedAt   DateTime?
  pausedAt    DateTime?

  /// Total seconds spent paused across the whole session.
  ///
  /// A paused session's deadline is `startedAt + planned + pausedTotal`, so this
  /// is what keeps the reconstructed end time in `adoptFromServerRow` honest
  /// across a resume. Without it every pause permanently shortens the session.
  ///
  /// Non-null with a zero default, deliberately. Every reader would otherwise
  /// need `(pausedTotalSeconds ?? 0)`, and the one place it really matters —
  /// `settleSession`, which derives whether a countdown has expired — is exactly
  /// the place a silent `null` would read as "no pause" and expire a session
  /// early.
  pausedTotalSeconds Int @default(0)

  /// Why the session ended. Null while it is active.
  ///
  /// Only `COMPLETED` counts as completed work; everything else is a partial or
  /// abandoned session. This is what makes a completion *rate* meaningful —
  /// without it, a session the user stopped at 30 seconds is indistinguishable
  /// from one that ran the full timebox.
  endReason FocusSessionEndReason?

  /// Where the row came from. Distinguishes a timer run from a session the user
  /// logged after the fact, and from one recovered after an interruption, so
  /// analytics can exclude the latter two if they should not count.
  source FocusSessionSource @default(TIMER)

  /// How many times the session was paused. Denormalised from the event log so
  /// interruption analytics need not scan events.
  pauseCount Int @default(0)

  /// Extra time granted by "+5 minutes". Kept separate from `plannedDuration` so
  /// planned-versus-actual accuracy stays answerable after an extension.
  extendedSeconds Int @default(0)

  /// Denormalised count of DISTRACTION events, written when a session ends.
  distractionCount Int @default(0)

  /// Last time a client proved the session was still being watched.
  ///
  /// Evidence only, never authority — see the recovery policy. A countdown whose
  /// deadline passed with heartbeats continuing to the deadline is full credit;
  /// one whose heartbeats stopped early is not.
  lastHeartbeatAt DateTime?

  /// The user's timezone at the moment the session started.
  ///
  /// Snapshotted so history does not silently re-bucket if the user later moves
  /// timezone: a session worked at 09:00 in Tokyo stays a morning session.
  timezone String?

  /// `startedAt` as a calendar date in `timezone`, stored as a `Date`.
  ///
  /// Denormalised purely so per-day queries and heatmaps are an index scan
  /// rather than a zone conversion per row.
  localDate DateTime? @db.Date

  /// Groups a chain of focus and break sessions the user moved through without
  /// stopping ("run"), so the pomodoro cycle count survives a reload.
  runId String?

  /// Position in the run's cycle, 0-based.
  cycleIndex Int?

  /// Client-generated idempotency key.
  ///
  /// Makes Start safe to retry, so a double click, a second tab, or an offline
  /// replay after reconnect cannot create two rows for one run.
  clientId String?

  // Links into the rest of the product. All nullable and all `SetNull`, so
  // deleting a task unlinks the session instead of failing the delete — the same
  // rule `TimeEntry` already follows for `goalId`.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  habitId String?
  habit   Habit?  @relation(fields: [habitId], references: [id], onDelete: SetNull)

  routineBlockId String?
  routineBlock   RoutineBlock? @relation(fields: [routineBlockId], references: [id], onDelete: SetNull)

  // Ratings
  focusRating        Int? // 1-5
  productivityRating Int? // 1-5
  difficultyRating   Int? // 1-5
  energyBefore       Int? // 1-5
  energyAfter        Int? // 1-5

  // Context
  distractions String? // JSON array
  techniques   String? // JSON array (e.g., Pomodoro, Deep Work)

  notes String? @db.Text

  breaks Break[]

  /// Append-only lifecycle log. See the model's own docstring for why this is not
  /// derivable from the session row.
  events FocusSessionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotent Start: a retried create collides here instead of duplicating.
  @@unique([userId, clientId])
  @@index([userId, startedAt])
  @@index([categoryId])
  @@index([userId, createdAt])
  // Every focus aggregate filters `completedAt`/`abortedAt` to decide what counts
  // as finished work, and the active-session lookup filters both to null. These
  // replace the `(userId, startedAt)`-only index for the stats queries, which are
  // the hottest reads on this table.
  @@index([userId, completedAt, abortedAt])
  // Per-type listings and per-type stats.
  @@index([userId, type, startedAt])
  // Per-day history, heatmaps and streak scans without a zone conversion.
  @@index([userId, localDate])
  // Run grouping for cycle counting.
  @@index([userId, runId])
  // Reverse lookups and roll-ups for the linked entities.
  @@index([taskId])
  @@index([goalId])
  @@index([habitId])
  @@index([routineBlockId])
}

enum FocusSessionEndReason {
  /// The timebox ran to zero, or the user confirmed it during recovery.
  COMPLETED
  /// The user pressed Reset or Stop.
  STOPPED
  /// The user pressed Skip.
  SKIPPED
  /// The user changed mode mid-run.
  MODE_SWITCHED
  /// Settled automatically after the session was abandoned.
  AUTO_STALE
  /// Logged by the user after the fact.
  MANUAL
}

enum FocusSessionSource {
  TIMER
  MANUAL
  RECOVERED
}

enum FocusEventType {
  START
  PAUSE
  RESUME
  EXTEND
  DISTRACTION
  NOTE
  END
  /// A pause the system caused rather than the user. Carries the reason so the
  /// timeline can distinguish "I paused" from "sleep started".
  PAUSE_REASON
}

enum BreakType {
  SHORT
  LONG
  MEAL
  WALK
  STRETCH
  REST
  CUSTOM
}

/// How a focus session was reflected on. `MIN_LENGTH` is the pragmatic default:
/// asking someone how a 3-minute block went is a chore they will skip forever.
enum FocusReflectionMode {
  ALWAYS
  FOCUS_ONLY
  MIN_LENGTH
  NEVER
}

model FocusSessionEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  focusSessionId String
  focusSession   FocusSession @relation(fields: [focusSessionId], references: [id], onDelete: Cascade)

  type       FocusEventType
  occurredAt DateTime       @default(now())

  /// Short machine-ish label, e.g. the distraction chip or the pause reason.
  label String?

  /// Free text: a parking-lot note, or the note attached to a distraction.
  note String? @db.Text

  /// Structured extras. Kept as JSON so a new event kind does not need a column.
  metadata String?

  createdAt DateTime @default(now())

  // The detail timeline reads one session's events in order.
  @@index([focusSessionId, occurredAt])
  // "Distractions over the last month" without loading every session's events.
  @@index([userId, occurredAt])
  @@index([userId, type])
}

/// Server-stored focus preferences.
///
/// A separate one-to-one model rather than more columns on `UserSettings`, which
/// is already very wide and has its own validation schema and settings page. The
/// master switches — `UserSettings.soundEnabled`, `timezone`, `focusReminders`,
/// `breakReminders` — are read from `UserSettings`, never duplicated here.
model FocusSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Durations
  focusMinutes          Int @default(25)
  shortBreakMinutes     Int @default(5)
  longBreakMinutes      Int @default(15)
  cyclesBeforeLongBreak Int @default(4)

  // Behaviour
  autoStartBreak  Boolean @default(true)
  autoStartFocus  Boolean @default(false)
  keepScreenAwake Boolean @default(false)

  // Reflection
  reflectionMode           FocusReflectionMode @default(MIN_LENGTH)
  reflectionMinimumMinutes Int                 @default(10)

  // Goals
  dailyTargetMinutes  Int  @default(120)
  /// Minutes that make a day count for the streak. Below this, opening the app
  /// and starting two sessions is enough to hold a streak, which makes the
  /// streak meaningless.
  streakDayMinutes    Int  @default(25)
  weeklyTargetMinutes Int?

  // Sound. Off by default: a focus tool that makes noise unasked is a nuisance.
  soundEnabled Boolean @default(false)
  soundVolume  Int     @default(50)
  ambientSound String?

  // Display
  showWallClock Boolean @default(true)

  // Intelligence
  breakSuggestions    Boolean @default(true)
  adaptiveSuggestions Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A named duration profile ("Deep work 90/20", "Study 50/10").
///
/// Replaces the eight hard-coded preset pills with something that can also carry
/// a default category, which is what makes starting from a preset one tap.
model FocusPreset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  focusMinutes          Int @default(25)
  shortBreakMinutes     Int @default(5)
  longBreakMinutes      Int @default(15)
  cyclesBeforeLongBreak Int @default(4)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  color String?
  icon  String?

  /// Position in the user's own ordering.
  sortOrder  Int     @default(0)
  /// Archived presets keep their history but leave the picker.
  isArchived Boolean @default(false)

  /// Seeded on first use; a seeded preset is not deleted, only archived.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sortOrder])
  @@index([userId, isArchived])
}

/// A per-day-type focus target, so an exam day can carry more and a low-energy
/// day less. Ties into the existing `DayTypeDefinition` system.
model FocusDayTypeTarget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dayTypeId String
  dayType   DayTypeDefinition @relation(fields: [dayTypeId], references: [id], onDelete: Cascade)

  targetMinutes Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayTypeId])
  @@index([userId])
}

model Break {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  focusSessionId String?
  focusSession   FocusSession? @relation(fields: [focusSessionId], references: [id], onDelete: SetNull)

  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?

  /// What the user actually did during the break.
  ///
  /// Was free text, now an enum. `Break` is repositioned as an *annotation* of a
  /// break session (the restorative activity and how good it was) rather than a
  /// second source of break minutes: break minutes come only from the
  /// SHORT_BREAK/LONG_BREAK `FocusSession` rows, so counting both would double
  /// every break.
  breakType BreakType?
  quality   Int? // 1-5

  notes String?

  createdAt DateTime @default(now())

  @@index([userId, startedAt])
  @@index([focusSessionId])
  @@index([userId, createdAt])
}

// ==========================================================================
// TIME TRACKING & PRODUCTIVITY PATTERNS
// ==========================================================================

model TimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  description String
  startTime   DateTime
  endTime     DateTime?
  duration    Int? // auto-calculated minutes

  // Relations
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  habitId   String?
  habit     Habit?   @relation(fields: [habitId], references: [id])
  // Same reasoning as `Task.goalId`: a time entry outlives the goal it was
  // logged against, so the link is nulled rather than blocking the delete.
  goalId    String?
  goal      Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  // Categorization
  billable Boolean @default(false)
  rate     Float?

  // Metadata
  tags        String? // JSON array
  isAutomatic Boolean @default(false) // AI-detected vs manual

  createdAt DateTime @default(now())

  @@index([userId, startTime])
  @@index([projectId, startTime])
  @@index([userId, createdAt])
}

model ProductivityPattern {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  patternType String // "PEAK_HOURS", "LOW_ENERGY", "CONTEXT_SWITCH"
  timeOfDay   String // "09:00-11:00"
  dayOfWeek   String // JSON array [1,2,3,4,5] for weekdays
  confidence  Float // 0-1, how confident the AI is

  metrics String @db.Text // JSON with detailed metrics

  discoveredAt DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([userId, patternType, timeOfDay])
  @@index([userId, createdAt])
}

