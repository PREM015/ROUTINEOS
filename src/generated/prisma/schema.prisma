  HABIT_STREAK
  GOAL_COMPLETED
  PERFECT_DAY
  PERFECT_WEEK
  PERFECT_MONTH
  PERFECT_QUARTER
  PERFECT_YEAR
  EARLY_RISER
  NIGHT_OWL
  PRODUCTIVITY_MASTER
  WELLNESS_WARRIOR
  FOCUS_CHAMPION
  CONSISTENCY_KING
  MILESTONE
  CUSTOM
